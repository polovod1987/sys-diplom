[bastion]
${fqdn["bastion"]} ansible_host=${bastion_ip}

[web]
${fqdn["web-1"]}
${fqdn["web-2"]}

[zabbix]
${fqdn["zabbix"]}

[db_primary]
${fqdn["db-primary"]}

[db_secondary]
${fqdn["db-secondary"]}

[db:children]
db_primary
db_secondary

[elastic]
${fqdn["elastic"]}

[kibana]
${fqdn["kibana"]}

[internal:children]
web
zabbix
db
elastic
kibana

[all:vars]
ansible_user=${user}

[internal:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -o StrictHostKeyChecking=accept-new ${user}@${bastion_ip}"'
