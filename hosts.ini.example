# Файл hosts.ini создаёт terraform apply. Это пример того, что получится.
[bastion]
bastion.ru-central1.internal ansible_host=203.0.113.10

[web]
web-1.ru-central1.internal
web-2.ru-central1.internal

[zabbix]
zabbix.ru-central1.internal

[db_primary]
db-primary.ru-central1.internal

[db_secondary]
db-secondary.ru-central1.internal

[db:children]
db_primary
db_secondary

[elastic]
elastic.ru-central1.internal

[kibana]
kibana.ru-central1.internal

[internal:children]
web
zabbix
db
elastic
kibana

[all:vars]
ansible_user=user

[internal:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -o StrictHostKeyChecking=accept-new user@203.0.113.10"'
