server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/diplom;
    index index.html;

    add_header X-Served-By $hostname always;

    location = /basic_status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
    }
}
